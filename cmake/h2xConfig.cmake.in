# h2xConfig.cmake
# -----------------
#
# CMake find-package configuration for the h2x library.
#
# This file is generated by the h2x build system and installed
# for use by consumers via find_package(h2x).
#
# Targets:
#   h2x::h2x  - Header-only INTERFACE library
#
# Usage:
#   find_package(h2x REQUIRED)
#   target_link_libraries(myapp PRIVATE h2x::h2x)
#

@PACKAGE_INIT@

# Compute the include directory relative to the config file location.
set_and_check(h2x_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

# Include the exported targets file.
include("${CMAKE_CURRENT_LIST_DIR}/h2xTargets.cmake")

# Verify the target was imported.
if(NOT TARGET h2x::h2x)
    message(FATAL_ERROR "h2x::h2x target was not found in h2xTargets.cmake")
endif()

# Propagate the include directory as a convenience variable.
set(h2x_INCLUDE_DIRS "${h2x_INCLUDE_DIR}")

# Mark as found.
set(h2x_FOUND TRUE)
